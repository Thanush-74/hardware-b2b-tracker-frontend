# Backend API Base URL (Default: http://localhost:3000)
# Update this if your backend is hosted on a different port or domain.
VITE_API_BASE_URL=http://localhost:3000

# Client-Side Session Idle Security (Default: 15 minutes = 900000 ms)
# Inactivity timer that automatically logs user out after 15 minutes of no activity
VITE_IDLE_TIMEOUT_MS=900000

# Inactivity Warning Modal Threshold (Default: 1 minute = 60000 ms before logout)
VITE_IDLE_WARNING_MS=60000